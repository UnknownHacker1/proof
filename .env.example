# Copy to .env and fill in. With no YOUCAM_API_KEY, Proof runs in mock (sample) mode.

# YouCam API key (API console > API Keys). V2 endpoints only need this key, no secret.
YOUCAM_API_KEY=

# Optional
# YOUCAM_QUALITY=sd            # sd (default, photos >= 480px short side) or hd (>= 1080px, costs more)
# YOUCAM_CONCERNS=acne,redness,pore,texture,wrinkle,moisture,oiliness,radiance,age_spot,dark_circle_v2
# YOUCAM_DELETE_AFTER=1        # delete the YouCam task and files right after reading results
# DAILY_UNIT_BUDGET=350        # live demo: stop spending units after this many per day
# PER_IP_DAILY_SCANS=15        # live demo: scans per visitor per day
# RECEIPT_SECRET=              # long random string; keeps scan signatures valid across restarts
# PROOF_MODE=mock              # force sample mode even with a key set
# PORT=3000
